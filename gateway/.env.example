# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=8787
# Public HTTPS URL that ElevenLabs can reach (`npm run tunnel` prints one). Used when provisioning tools.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Persistence ---
# MongoDB Atlas connection string (replica set required for transactions — every Atlas tier qualifies).
# `memory` = throwaway in-process replica set for local dev only (nothing survives a restart).
MONGODB_URI=memory
MONGODB_DB=intervention_gateway

# --- Shared secrets (generate: openssl rand -hex 24) ---
# Bearer token the robotics harness uses for POST /v1/incidents and /v1/harness/events.
HARNESS_TOKEN=
# Bearer token ElevenLabs sends on every webhook tool call (stored as a workspace secret by provision:agent).
TOOL_SECRET=
# Optional bearer token for the dashboard API. Empty = open (demo only).
DASHBOARD_TOKEN=

# --- Robotics harness ---
# mock = in-process synthetic scenarios (default); http = real harness per docs/HARNESS_CONTRACT.md
HARNESS_MODE=mock
HARNESS_BASE_URL=
HARNESS_OUTBOUND_TOKEN=
HARNESS_TIMEOUT_MS=10000

# --- Calls (simulated phone leg; Twilio is intentionally not enabled) ---
# simulated = rings the dashboard softphone; scripted = auto-answer (tests/offline)
CALL_MODE=simulated
CALL_RING_TIMEOUT_MS=45000
CALL_RETRY_DELAY_MS=120000
CALL_MAX_ATTEMPTS=2
# An answered call whose voice session never connects is ended after this
CALL_CONNECT_TIMEOUT_MS=90000

SUPERVISOR_SYNC_BUDGET_MS=8000

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# Printed by `npm run provision:agent` on first run.
ELEVENLABS_AGENT_ID=
# LLM used by the voice agent (ElevenLabs-hosted).
ELEVENLABS_AGENT_LLM=claude-sonnet-5-5
# HMAC secret shown when you register the post-call webhook in the ElevenLabs dashboard.
ELEVENLABS_WEBHOOK_SECRET=

# --- Mock supervisor (optional) ---
# With a key, the mock supervisor answers with Claude grounded in the scenario evidence; without, deterministic lookup.
ANTHROPIC_API_KEY=
MOCK_SUPERVISOR_MODEL=claude-opus-5-5
