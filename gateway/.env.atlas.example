# Same as .env but persisted in MongoDB Atlas. Copy to .env and fill in the placeholders. Never commit a filled-in copy.

# --- Server ---
PORT=8787
# Local by default. For live ElevenLabs tools, replace with the https URL printed by `npm run tunnel` and re-run `npm run provision:agent`.
PUBLIC_BASE_URL=http://localhost:8787

# --- Persistence ---
# Atlas connection string (every Atlas tier is a replica set, so transactions work). Add your IP under Atlas -> Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DB=intervention_gateway

# --- Robotics harness (real, over HTTP; see docs/HARNESS_CONTRACT.md) ---
HARNESS_MODE=http
HARNESS_BASE_URL=http://localhost:8000
# The harness sends this on POST /v1/incidents.
HARNESS_TOKEN=dev-harness-token-change-me
# The gateway sends this on every call to the harness (routes B-F).
HARNESS_OUTBOUND_TOKEN=harness-outbound-dev-token-0001
HARNESS_TIMEOUT_MS=10000

# --- Shared secrets ---
# Bearer token ElevenLabs sends on every webhook tool call; also used by `npm run simulate:agent`.
TOOL_SECRET=<openssl rand -hex 24>
DASHBOARD_TOKEN=

# --- Calls ---
# simulated = rings the dashboard softphone; scripted = auto-answer (use with npm run simulate:agent)
CALL_MODE=simulated
CALL_RING_TIMEOUT_MS=45000
CALL_RETRY_DELAY_MS=120000
CALL_MAX_ATTEMPTS=2
CALL_CONNECT_TIMEOUT_MS=90000
SUPERVISOR_SYNC_BUDGET_MS=8000

# --- ElevenLabs (fill these in yourself; leave empty to run without voice) ---
ELEVENLABS_API_KEY=
# Printed by `npm run provision:agent` on first run.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_LLM=claude-sonnet-5-5
ELEVENLABS_WEBHOOK_SECRET=

# --- Mock supervisor (unused in http mode) ---
ANTHROPIC_API_KEY=
MOCK_SUPERVISOR_MODEL=claude-opus-5-5
